<main class="max-w-md mx-auto p-4 space-y-6">
    <div class="bg-white border-2 border-black rounded-2xl p-6 neo-shadow">
        <!-- Tab Header -->
        <div class="flex border-b-2 border-black mb-6">
            <button id="tab1" class="flex-1 py-2 font-extrabold text-sm rounded-t-xl bg-[#93c5fd] border-b-2 border-b-black text-black neo-shadow-sm relative z-10">1. Email</button>
            <button id="tab2" class="flex-1 py-2 font-extrabold text-sm rounded-t-xl text-gray-500 bg-transparent shadow-none z-0 border-b-0">2. Verifikasi Link</button>
            <button id="tab3" class="flex-1 py-2 font-extrabold text-sm rounded-t-xl text-gray-500 bg-transparent shadow-none z-0 border-b-0">3. Selesai</button>
        </div>

        <!-- Form Step 1: Input Email -->
        <form id="emailForm" class="space-y-4">
            <div>
                <label for="emailInput" class="block text-xs font-bold text-gray-700 uppercase mb-2">Alamat Email Alight Motion</label>
                <input type="email" id="emailInput" required placeholder="nama@gmail.com" class="w-full p-3 border-2 border-black rounded-xl text-sm font-bold bg-[#fbf9f1] focus:outline-none focus:bg-white transition-all">
            </div>
            <button type="submit" id="btnEmail" class="w-full py-3 bg-[#a5c9fc] border-2 border-black rounded-xl font-extrabold text-sm neo-shadow-sm neo-btn flex items-center justify-center gap-2">
                <span>Kirim Link Verifikasi</span>
                <i class="fa-solid fa-paper-plane"></i>
            </button>
        </form>

        <!-- Form Step 2: Input Link OOB -->
        <form id="oobForm" class="space-y-4 hidden">
            <div>
                <label for="oobInput" class="block text-xs font-bold text-gray-700 uppercase mb-2">Tempel Link Verifikasi (OOB Link)</label>
                <textarea id="oobInput" required rows="3" placeholder="https://alightcreative.page.link/..." class="w-full p-3 border-2 border-black rounded-xl text-xs font-bold bg-[#fbf9f1] focus:outline-none focus:bg-white transition-all"></textarea>
            </div>
            <button type="submit" id="btnOob" class="w-full py-3 bg-[#d2f4d6] border-2 border-black rounded-xl font-extrabold text-sm neo-shadow-sm neo-btn flex items-center justify-center gap-2">
                <span>Verifikasi & Aktifkan</span>
                <i class="fa-solid fa-bolt"></i>
            </button>
        </form>

        <!-- Step 3: Hasil Verifikasi -->
        <div id="resultStep" class="text-center py-4 hidden">
            <div id="resultIcon"></div>
            <h3 id="resultTitle" class="text-xl font-extrabold mb-2"></h3>
            <p id="resultMessage" class="text-xs font-bold text-gray-600 mb-6"></p>
            <a href="/" class="inline-block px-6 py-2 bg-black text-white font-bold rounded-xl text-xs">Kembali ke Awal</a>
        </div>
    </div>
</main>